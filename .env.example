# ===========================================================================
#  Wheel_Chair_Project_V2 — copy to .env.local. Points at the SAME Supabase
#  project as the original Wheel_Chair_Project (same hardware, APIs, schema).
# ===========================================================================
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only, used by the route handlers under app/api/. It bypasses RLS
# entirely, so it must NEVER gain a NEXT_PUBLIC_ prefix and must never be
# imported from lib/ — everything there ships to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=replace-me

# Require a clicked email link before a new account can sign in.
# Leave false until real SMTP is configured (Project Settings -> Auth -> SMTP):
# Supabase's built-in mailer allows only a few messages an hour, so turning
# this on without SMTP locks riders out of accounts they just created.
AUTH_REQUIRE_EMAIL_CONFIRMATION=false
